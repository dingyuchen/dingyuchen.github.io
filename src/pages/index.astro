---
import Layout from "../layouts/Layout.astro";
import { combinedCollection } from "../utils/entrypoints";

const entries = combinedCollection.sort((a, b) => {
	const dateA = a.data.date ? new Date(a.data.date).valueOf() : 0;
	const dateB = b.data.date ? new Date(b.data.date).valueOf() : 0;
	return dateB - dateA;
});
---

<Layout>
	<section class="border-b border-gray-200 dark:border-gray-800">
		<div class="max-w-5xl mx-auto px-6 py-5 md:py-6">
			<h1
				class="text-2xl font-mono md:text-3xl lg:text-4xl font-bold leading-tight mb-3 text-gray-900 dark:text-gray-100"
			>
				<span
					class="inline-block bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 py-0.5"
					>P</span
				>roof Of Concepts
			</h1>
			<p
				class="text-base md:text-lg max-w-2xl text-gray-600 dark:text-gray-400"
			>
				Turning my shower thoughts into reality.
			</p>
		</div>
	</section>

	<section class="max-w-3xl mx-auto px-6 py-6">
		<div>
			{
				entries.map((entry) => (
					<a href={`/${entry.id}`} class="block">
						<article class="border-b-4 border-gray-900 dark:border-gray-100 px-1 py-5 hover:-translate-y-1 transition-all duration-200">
							<div class="flex items-start justify-between gap-2">
								<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
									{entry.collection === "til"
										? "TIL"
										: entry.data.title}
								</h3>
								{entry.data.date && (
									<time class="font-mono text-sm text-gray-500 dark:text-gray-500 shrink-0 pt-0.5">
										{new Date(
											entry.data.date,
										).toLocaleDateString("en-US", {
											year: "numeric",
											month: "short",
											day: "numeric",
										})}
									</time>
								)}
							</div>
						</article>
					</a>
				))
			}
		</div>
	</section>
</Layout>
