---
import Layout from "../layouts/Layout.astro";
import BlogPost from "../components/BlogPost.astro";
import TilPost from "../components/TilPost.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = (await getCollection("blog")).filter(
		(post) => !post.data.hidden,
	);
	const tils = await getCollection("til");
	return [
		...posts.map((post) => ({
			params: { slug: post.id },
			props: { content: post },
		})),
		...tils.map((til) => ({
			params: { slug: til.id },
			props: { content: til },
		})),
	];
}

const { content } = Astro.props;
const { Content } = await render(content);
---

{
	content.collection === "til" ? (
		<Layout title="TIL">
			<TilPost content={content} Content={Content} />
		</Layout>
	) : (
		<Layout title={content.data.title}>
			<BlogPost content={content} Content={Content} />
		</Layout>
	)
}
