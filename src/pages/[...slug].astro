---
import Layout from "../layouts/Layout.astro";
import BlogPost from "../components/BlogPost.astro";
import TilPost from "../components/TilPost.astro";
import { getCollection, render } from "astro:content";
import { combinedCollection } from "../utils/entrypoints";

export async function getStaticPaths() {
	return combinedCollection.map((entry) => ({
		params: { slug: entry.id },
		props: { content: entry },
	}));
}

const { content } = Astro.props;
const { Content } = await render(content);
---

{
	content.collection === "til" ? (
		<Layout title="TIL">
			<TilPost content={content} Content={Content} />
		</Layout>
	) : (
		<Layout title={content.data.title}>
			<BlogPost content={content} Content={Content} />
		</Layout>
	)
}
