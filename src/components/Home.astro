---
import { entrypointStyles, entrypoints } from "../utils/entrypoints";

const scopedStyles = entrypointStyles.replace(
	/\.expressive-code/g,
	".nav-code",
);

const renderedEntrypoints = entrypoints.map(({ highlighted }) =>
	highlighted.replace(/class="expressive-code"/g, 'class="nav-code"'),
);
---

<style set:html={scopedStyles}></style>
{
	renderedEntrypoints.map((html, i) => (
		<a
			href="/"
			data-entry
			class="not-prose max-w-1/2 truncate"
			class:list={[{ hidden: i !== 0 }]}
			set:html={html}
			aria-label="Home"
		/>
	))
}
<script is:inline data-astro-rerun>
	{
		const entries = document.querySelectorAll("[data-entry]");
		const idx = Math.floor(Math.random() * entries.length);
		console.log(`Showing entry ${idx + 1} of ${entries.length}`);
		for (const [i, entry] of entries.entries()) {
			if (!entry.classList.toggle("hidden", i !== idx)) {
				break;
			}
		}
	}
</script>
