---
import { Code } from "astro-expressive-code/components";
interface Props {
  comment: string;
  body: string;
  language?: string;
}

const { comment, body, language = "cpp" } = Astro.props;
---

<div
  class="my-6 rounded-lg border border-neutral-200 dark:border-neutral-700 overflow-hidden bg-[#f6f8fa] dark:bg-[#1f2428]"
>
  <Code lang={language} code={body} useDiffSyntax />
  <blockquote
    class="p-4 text-sm italic bg-neutral-100 dark:bg-neutral-800 border-l-4 border-neutral-300 dark:border-neutral-600"
  >
    {comment}
  </blockquote>
</div>
