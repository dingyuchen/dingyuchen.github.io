---
import LinkPreview from "./LinkPreview.astro";

interface Props {
	content: any;
	Content: any;
}

const { content, Content } = Astro.props;
---

<article>
	<header class="border-b border-gray-200 dark:border-gray-800">
		<div class="max-w-4xl mx-auto px-6 py-5 flex flex-col gap-4">
			<LinkPreview href={content.data.source} />
			<time class="font-mono text-sm text-gray-500 dark:text-gray-500">
				{
					new Date(content.data.date).toLocaleDateString("en-US", {
						year: "numeric",
						month: "short",
						day: "numeric",
					})
				}
			</time>
		</div>
	</header>

	<div class="max-w-4xl mx-auto px-6 py-10">
		<div class="prose dark:prose-invert max-w-none">
			<Content />
		</div>
	</div>

	<div class="max-w-4xl mx-auto px-6 pb-10">
		<a
			href="/"
			class="inline-block text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
		>
			&larr; Back to all posts
		</a>
	</div>
</article>
